FROM golang:1.27-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o api ./cmd/api

FROM alpine:3.22
WORKDIR /app
COPY --from=builder /app/api .
# Our license and the third-party notices the binary is distributed
# under (THIRD_PARTY_LICENSES.txt is generated by `make licenses`).
COPY LICENSE THIRD_PARTY_LICENSES.txt /usr/share/licenses/go-webapp-template/
EXPOSE 8080
CMD ["./api"]
