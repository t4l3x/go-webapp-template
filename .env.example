# Local development settings: `cp .env.example .env` and it works as is.
# Every value here is a development-only default — never reuse a secret
# below outside your machine.
#
# Values are written from the HOST's point of view (localhost + the
# ports Docker publishes), because that is where `make run`,
# `make run-worker` and `make migrate-*` execute. The containers started
# by `make up` read this file too; docker/docker-compose.dev.yml then
# overrides the few addresses that differ inside the Docker network
# (DB_DSN, REDIS_URL, MAIL_HOST). Production injects its own values and
# never uses this file. See README "Configuration contexts".

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=local
APP_VERSION=dev
# APP_SERVICE labels logs and is set per process (api / worker) by the
# Makefile and Compose, so it is intentionally not set here.

# Origin of the user-facing application (the frontend), not this API.
# Used for links mailed to people, e.g. the worker's email-verification
# link: <APP_PUBLIC_URL>/verify-email?token=... Must be an absolute
# http(s) URL with no query or fragment; a trailing slash is ignored.
APP_PUBLIC_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------
HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_CORS_ALLOWED_ORIGINS=

# Reverse proxies allowed to supply a client's real IP via
# X-Forwarded-For/X-Real-IP (CIDR notation; use /32 or /128 for a
# single IP). Empty means forwarded headers are never trusted.
HTTP_TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
# Host-side address of the dev Postgres from `make up`. Used by
# `make run`, `make run-worker` and every `make migrate-*` target.
# Compose overrides it to postgres:5432 inside the Docker network.
DB_DSN=postgres://postgres:postgres@localhost:5432/go_webapp_template?sslmode=disable

DB_MAX_CONNS=10
DB_MIN_IDLE_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_LIFETIME_JITTER=5m
DB_MAX_CONN_IDLE_TIME=15m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s
DB_PING_TIMEOUT=5s

# -----------------------------------------------------------------------------
# Test database
# -----------------------------------------------------------------------------
# Admin connection to the separate, disposable test Postgres
# (docker/docker-compose.test.yml, port 5434). Used only by
# `make test-integration` and `make migrate-test`, which create and drop
# their own uniquely named databases through it. Never point it at a
# database whose data you care about.
DB_DSN_TEST_ADMIN=postgres://postgres:postgres@localhost:5434/postgres?sslmode=disable

# -----------------------------------------------------------------------------
# Identity / Auth
# -----------------------------------------------------------------------------
AUTH_PASSWORD_MIN_LENGTH=12

# Signs session access tokens. Needed by cmd/api only. The dev
# placeholder works locally; generate a real one (e.g.
# `openssl rand -base64 48`) for any shared or deployed environment.
AUTH_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0000000000
AUTH_JWT_ISSUER=go-webapp-template
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_EMAIL_VERIFICATION_TTL=24h

# Shared by cmd/api (verification) and cmd/worker (signing).
# Must differ from AUTH_JWT_SECRET; the API checks this at startup.
AUTH_EMAIL_VERIFICATION_SECRET=dev-only-insecure-email-verification-secret-change-me-00

# Identity endpoint rate limits, requests per minute. Platform owns the
# mechanics; this module owns what its own endpoints are worth. Starting
# points, not settled values -- tune from real traffic.
AUTH_RATE_LIMIT_REGISTER_PER_MINUTE=5
AUTH_RATE_LIMIT_LOGIN_IP_PER_MINUTE=15
AUTH_RATE_LIMIT_REFRESH_PER_MINUTE=30

# -----------------------------------------------------------------------------
# Outbox (cmd/worker)
# -----------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=10

# Worker startup requires ClaimLease > BatchSize * (MAIL_TIMEOUT + 5s).
# Each handler receives a deadline within its share of the lease.
OUTBOX_CLAIM_LEASE=3m
OUTBOX_BASE_BACKOFF=5s
OUTBOX_MAX_BACKOFF=5m
OUTBOX_SHUTDOWN_TIMEOUT=10s

# -----------------------------------------------------------------------------
# Mail (cmd/worker) — see docs/guides/local_mail.md
# -----------------------------------------------------------------------------
# Host-side Mailpit; Compose overrides MAIL_HOST to mailpit in the worker.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@go-webapp-template.local

# none | starttls | implicit. Mailpit doesn't speak TLS, so "none" locally.
MAIL_TLS_POLICY=none
MAIL_TIMEOUT=10s

# -----------------------------------------------------------------------------
# Localization (cmd/worker)
# -----------------------------------------------------------------------------
# Locale used when a recipient's own locale is unknown. It is the last
# link in the fallback chain, so a catalog for it must exist or the
# worker refuses to start. Supported locales are not configured here —
# the registered catalogs are the authoritative set.
I18N_DEFAULT_LOCALE=en

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Host-side dev Redis (cmd/api only); Compose overrides it to redis:6379.
REDIS_URL=redis://localhost:6379/0

# Redis used by the integration suite (docker-compose.test.yml). Kept
# separate from the development instance so limiter tests can delete
# the keys they create without touching local development state.
REDIS_URL_TEST=redis://localhost:6380/0

# -----------------------------------------------------------------------------
# Rate limiting (cmd/api)
# -----------------------------------------------------------------------------
# Generic per-IP allowance across the whole API. A blunt backstop, not a
# security control -- sensitive endpoints carry their own stricter
# limits (see AUTH_RATE_LIMIT_* below). Conservative default chosen
# without traffic data: tune per environment from real percentiles.
RATELIMIT_GLOBAL_PER_MINUTE=300

# Requests a previously idle IP may make at once. 0 means "a full
# minute's allowance".
RATELIMIT_GLOBAL_BURST=0

# Bounds a single limiter check. Short on purpose: this runs on every
# request, so a slow Redis must degrade to fail-open quickly rather than
# adding latency to every response.
RATELIMIT_TIMEOUT=200ms